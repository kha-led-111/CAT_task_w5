using System.Threading;


namespace solving
{
    internal class Program
    {
        static async Task Main(string[] args)
        {
            Console.WriteLine("fetching list");
            List<int> evens = await fetchlist();
            for (int i = 0; i < evens.Count; i++) {
                Console.WriteLine($"even number is:{evens[i]}");
            
            }
        }

        public static async Task<List<int>> fetchlist(){
            await Task.Delay(1000);
            List<int> list1 = Enumerable.Range(1, 10).ToList();
            List<int> list2 = new List<int>();
            
            for(int i = 0; i < list1.Count; i++)
            {
                if (list1[i] % 2 == 0)
                {
                    list2.Add(list1[i]);
                }
            }

            return list2;
        }
    }
}
